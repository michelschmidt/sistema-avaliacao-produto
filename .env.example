# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Nunca use o prefixo NEXT_PUBLIC_ nestas variáveis.
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# Segredo para assinar o cookie de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=<seu-segredo>

# Chave da OpenAI para o agente Mastra de resumo das avaliações (só servidor)
OPENAI_API_KEY=<sua-chave-openai>
